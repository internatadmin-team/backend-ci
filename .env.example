# Modele de configuration. Copier en .env (ignore par Git) et remplacer chaque valeur.
# Aucune valeur de ce fichier ne doit etre utilisee telle quelle en dehors du poste de developpement.

# --- PostgreSQL ---
DB_URL=jdbc:postgresql://localhost:5432/internatadmin
DB_USERNAME=internatadmin
DB_PASSWORD=changer-moi

# --- JWT HS256 : cle encodee en base64, 256 bits minimum (openssl rand -base64 32) ---
JWT_SECRET=
JWT_EXPIRATION_MINUTES=480

# --- Compte admin initial ---
# Hash BCrypt du mot de passe initial du compte admin (changement force a la premiere connexion).
# Utilise uniquement a la creation du compte, quand aucun compte ADMIN n'existe.
# Generation : ./scripts/hash-admin-password.sh
# Toujours entre apostrophes simples : sinon le shell et Docker interpretent les $ du hash.
ADMIN_INITIAL_PASSWORD_HASH=

# --- CORS : origines autorisees, separees par des virgules ---
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Dossier du logo de l'etablissement ---
LOGO_DIR=uploads/logos

# --- Port de l'application (URL du frontend : http://localhost:8080/api) ---
SERVER_PORT=8080

# --- Delai d'attente du verrou d'une mensualite, au-dela : 503 ---
PAIEMENT_LOCK_TIMEOUT=5s
